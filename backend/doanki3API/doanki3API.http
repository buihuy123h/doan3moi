@doanki3API_HostAddress = http://localhost:5105

### Tổng quan kỹ thuật
GET {{doanki3API_HostAddress}}/api/Technical/dashboard
Accept: application/json

### Danh sách đơn chờ kiểm tra
GET {{doanki3API_HostAddress}}/api/Technical/orders?status=Pending
Accept: application/json

### Kiểm tra tính khả thi (thay ORDER_ID và EMPLOYEE_ID)
PUT {{doanki3API_HostAddress}}/api/Technical/orders/ORDER_ID/feasibility
Content-Type: application/json

{
  "isFeasible": true,
  "landlineFeasible": true,
  "internetFeasible": true,
  "checkedBy": "EMPLOYEE_ID",
  "notes": "Hạ tầng đáp ứng yêu cầu",
  "cableDistanceMeters": 250,
  "dpBoxCapacity": "Port 3 Available / DP-A01",
  "signalLossDbm": -16.5
}

### Lên lịch lắp đặt
PUT {{doanki3API_HostAddress}}/api/Technical/orders/ORDER_ID/installation-schedule
Content-Type: application/json

{
  "scheduledInstallDate": "2026-09-20T09:00:00",
  "technicianId": "EMPLOYEE_ID"
}

### Thiết bị chưa được gán
GET {{doanki3API_HostAddress}}/api/Technical/equipment?availableOnly=true
Accept: application/json

### Cấp kết nối
POST {{doanki3API_HostAddress}}/api/Technical/orders/ORDER_ID/provide-connection
Content-Type: application/json

{
  "equipmentId": "EQUIPMENT_ID",
  "ipAddress": "192.168.1.10",
  "portNumber": "P01",
  "performedBy": "EMPLOYEE_ID"
}

### Tạm ngừng kết nối
PUT {{doanki3API_HostAddress}}/api/Technical/connections/ACCOUNT_ID/status
Content-Type: application/json

{
  "status": "Temporarily Inactive",
  "reason": "Bảo trì đường truyền",
  "performedBy": "EMPLOYEE_ID"
}

### Lịch sử kết nối
GET {{doanki3API_HostAddress}}/api/Technical/connections/ACCOUNT_ID/activity-logs
Accept: application/json

### Mặt hàng sắp hết
GET {{doanki3API_HostAddress}}/api/Technical/inventory?lowStockOnly=true
Accept: application/json

### Nhập thêm 5 đơn vị tồn kho
POST {{doanki3API_HostAddress}}/api/Technical/inventory/INVENTORY_ID/adjust-stock
Content-Type: application/json

{
  "quantityChange": 5,
  "reason": "Nhập thêm từ nhà cung cấp"
}
